# Configuration of the scripts in scripts/. The dashboard has its own dashboard/.env.example.

# ===================
# Database
# ===================

# PostgreSQL connection string (required)
DATABASE_URL=postgresql://user:password@host:5432/database

# Neon
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/database?sslmode=require

# Railway
# DATABASE_URL=postgresql://postgres:password@host.railway.app:5432/railway

# ===================
# Script Deployment
# ===================

# Path to a Firefox profile that is already logged into the platforms you scrape.
# Required for cloud deployment (Railway, Render, Fly.io).
# On cloud, point this to the profile directory on a persistent volume.
# Leave unset for local runs — the script will detect your local Firefox profile automatically.
FIREFOX_PROFILE_PATH=

# Path to the Firefox binary, only needed when firefox is not on your PATH.
FIREFOX_BINARY=

# ===================
# LLM
# ===================

# Provider for weekly summaries (summarize_weeks.py): 'anthropic', 'openai', 'ollama' or 'claude_code'.
# 'claude_code' runs through the local Claude Code CLI and uses your logged-in subscription
# (leave ANTHROPIC_API_KEY unset, otherwise the CLI bills the API instead).
LLM_PROVIDER=anthropic

# Provider for the per-post language check of all social media scrapers (only Dutch posts are kept):
# 'anthropic', 'openai', 'ollama' or 'claude_code'. Defaults to 'ollama', a local model.
LANGUAGE_DETECTION_PROVIDER=ollama

# Set to false to turn off all article translation at once
TRANSLATION_ENABLED=true
# Provider for translating articles into English (scrape_russian_rss.py and backfill_article_translations.py). Defaults to a local model.
TRANSLATION_PROVIDER=ollama
# Model used for translating, independent of OLLAMA_MODEL / ANTHROPIC_MODEL etc. below
TRANSLATION_MODEL=gemma4:latest
# Comma separated article languages that get translated
TRANSLATE_ARTICLE_LANGUAGES=ru

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Claude Code (subscription, requires `pip install claude-agent-sdk` and a logged-in `claude` CLI)
# CLAUDE_CODE_MODEL=

# OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# Ollama (local, no API key needed)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# ===================
# Article scraping (Russian news outlets)
# ===================

# Optional: route around ISP-level DNS blocking of the Russian source domains.
# DNS_RESOLVER is used for Python-side lookups (feedparser).
# DNS_OVER_HTTPS_URL is used by the Selenium/Firefox browser for article scraping.
DNS_RESOLVER=1.1.1.1
DNS_OVER_HTTPS_URL=https://cloudflare-dns.com/dns-query
